{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fde-clip",
  "version": "0.2.0",
  "identifier": "com.fdeclip.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fde-clip",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
